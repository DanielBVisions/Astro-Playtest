---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'SHOUT is the Creator Performance Platform built to change how brands and creators work together.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Darker+Grotesque:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/*
	  Design tokens pulled from Figma (get_variable_defs on node 1502:6087,
	  file SHOUT-Dev). Font sizes/weights match the design system's
	  display/h1/h3/h4/h5/paragraph scale.
	*/
	:root {
		--color-bg: #ffffff;
		--color-surface: #f7f7f7;
		--color-black: #000000;
		--color-purple: #6508fb;
		--color-pink: #95159e;
		--color-text: #000000;
		--color-text-muted: #666666;
		--color-text-invert: #ffffff;
		--color-text-invert-muted: #eaeaea;

		--font-display: 'Darker Grotesque', system-ui, -apple-system, 'Segoe UI', sans-serif;

		--font-size-display: 100px;
		--font-size-h1: 80px;
		--font-size-h3: 48px;
		--font-size-h4: 32px;
		--font-size-h5: 24px;
		--font-size-p-md: 18px;
		--font-size-p-sm: 16px;

		--max-width: 1312px;
		--radius-card: 16px;
		--radius-button: 8px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		color-scheme: light;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-display);
		-webkit-font-smoothing: antialiased;
	}

	img {
		max-width: 100%;
		display: block;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	p {
		margin: 0;
	}

	.container {
		width: 100%;
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: 24px;
	}

	.eyebrow {
		display: inline-block;
		font-weight: 600;
		font-size: var(--font-size-p-md);
		color: var(--color-purple);
		margin: 0 0 8px;
	}

	.section-heading {
		font-weight: 600;
		font-size: var(--font-size-h3);
		line-height: 0.8;
		letter-spacing: -1px;
		margin: 0 0 16px;
	}

	.section-lede {
		font-weight: 600;
		font-size: var(--font-size-h5);
		line-height: 1.3;
		color: var(--color-text-muted);
		margin: 0;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--font-size-p-md);
		text-decoration: none;
		border-radius: var(--radius-button);
		padding: 16px 18px;
		border: none;
		cursor: pointer;
	}

	.button--black {
		background: var(--color-black);
		color: var(--color-text-invert);
	}

	.button--grey {
		background: var(--color-surface);
		color: var(--color-text);
	}

	.button--white {
		background: var(--color-text-invert);
		color: var(--color-text);
	}

	section {
		padding-block: 96px;
	}

	@media (max-width: 720px) {
		section {
			padding-block: 56px;
		}

		:root {
			--font-size-display: 56px;
			--font-size-h1: 44px;
			--font-size-h3: 34px;
		}
	}
</style>
