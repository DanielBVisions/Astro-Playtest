---
// Copy from Figma nodes 1502:8011, 1502:8020, 1502:8021, 1502:8070,
// 1502:8097-8108 (team cards), 1502:8109-8110 (wider team + CTA).
const team = [
	{
		name: 'Jordan Blake',
		role: 'Founder',
		bio: 'Exits. Scaling teams. Building platforms that drive real impact.',
	},
	{
		name: 'Maya Chen',
		role: 'COO',
		bio: 'Operations at scale. Turning complexity into performance.',
	},
	{
		name: 'Alex Rees',
		role: 'CTO',
		bio: 'Platform architect. Data-driven products built for the future.',
	},
	{
		name: 'Sophie Moore',
		role: 'CPO',
		bio: 'Creator-first products that solve real problems.',
	},
];
---

<section class="team">
	<div class="container">
		<p class="eyebrow">Leadership team</p>
		<h2>Built by operators. Backed by leaders.</h2>
		<p class="team__lede">
			We're a tight team of builders, creators, and operators who've scaled companies and
			campaigns from the ground up.
		</p>

		<div class="team__layout">
			<div>
				<h3 class="team__heading">Meet the team</h3>
				<div class="team__grid">
					{
						team.map((person) => (
							<article class="team__card">
								<div class="team__avatar" aria-hidden="true" />
								<p class="team__role">{person.role}</p>
								<p class="team__name">{person.name}</p>
								<p class="team__bio">{person.bio}</p>
							</article>
						))
					}
				</div>
			</div>

			<aside class="team__cta">
				<p>
					And a wider team of specialists, creators and operators working in the trenches every
					day.
				</p>
				<div class="team__cta-footer">
					<span>Want to join us?</span>
					<a href="#" class="button">View open roles</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		margin: 0 0 16px;
		max-width: 640px;
	}

	.team__lede {
		font-size: 16px;
		color: var(--color-text-muted);
		max-width: 560px;
		margin: 0 0 56px;
	}

	.team__heading {
		font-size: 22px;
		font-weight: 700;
		margin: 0 0 24px;
	}

	.team__layout {
		display: grid;
		grid-template-columns: 1fr 260px;
		gap: 24px;
		align-items: start;
	}

	.team__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.team__card {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 16px;
	}

	.team__avatar {
		aspect-ratio: 1;
		border-radius: var(--radius-md);
		background: linear-gradient(135deg, var(--color-accent), var(--color-bg-raised));
		margin-bottom: 16px;
	}

	.team__role {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 6px;
	}

	.team__name {
		font-size: 16px;
		font-weight: 700;
		margin: 0 0 10px;
	}

	.team__bio {
		font-size: 13px;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	.team__cta {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 20px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		min-height: 220px;
	}

	.team__cta p {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	.team__cta-footer {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.team__cta-footer span {
		font-size: 14px;
		font-weight: 600;
	}

	.button {
		display: inline-block;
		text-align: center;
		background: var(--color-accent);
		color: var(--color-accent-text);
		font-weight: 700;
		font-size: 14px;
		text-decoration: none;
		border-radius: var(--radius-full);
		padding: 14px 20px;
	}

	@media (max-width: 900px) {
		.team__layout {
			grid-template-columns: 1fr;
		}

		.team__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 560px) {
		.team__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
