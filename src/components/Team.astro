---
import { Image } from 'astro:assets';
import teamBanner from '../assets/about/team-banner.png';
import jordanPhoto from '../assets/about/team-jordan-blake.png';
import mayaPhoto from '../assets/about/team-maya-chen.png';
import alexPhoto from '../assets/about/team-alex-rees.png';
import sophiePhoto from '../assets/about/team-sophie-moore.png';

// Copy from Figma nodes 1502:8011/8020/8021/8070 (heading), 1502:8097-8108
// (team cards), 1502:8109-8110 (wider team blurb + CTA card). Card style
// (white bg, rounded-16, purple glow shadow) confirmed via
// get_design_context on 1502:8092 "Rectangle 673" — 250x408 with a 15px
// inset for the avatar. Photos are the real exports from Daniel's
// About.zip: team-banner.png (Rectangle 682) and team-*.png (Rectangles
// 677-680, matched to names by their x position in Figma: 677→Jordan
// Blake, 678→Maya Chen, 679→Alex Rees, 680→Sophie Moore).
const team = [
	{
		name: 'Jordan Blake',
		role: 'Founder',
		bio: 'Exits. Scaling teams. Building platforms that drive real impact.',
		photo: jordanPhoto,
	},
	{
		name: 'Maya Chen',
		role: 'COO',
		bio: 'Operations at scale. Turning complexity into performance.',
		photo: mayaPhoto,
	},
	{
		name: 'Alex Rees',
		role: 'CTO',
		bio: 'Platform architect. Data-driven products built for the future.',
		photo: alexPhoto,
	},
	{
		name: 'Sophie Moore',
		role: 'CPO',
		bio: 'Creator-first products that solve real problems.',
		photo: sophiePhoto,
	},
];
---

<section class="team">
	<div class="container">
		<div class="team__heading">
			<p class="eyebrow">Leadership team</p>
			<h2 class="section-heading">Built by operators. <span class="team__accent">Backed by leaders.</span></h2>
			<p class="section-lede">
				We're a tight team of leaders, creators, and operators who've scaled companies and
				campaigns from the ground up.
			</p>
		</div>

		<Image
			class="team__banner"
			src={teamBanner}
			alt="The SHOUT team collaborating"
			loading="lazy"
			widths={[656, 1312, 1968]}
			sizes="(max-width: 900px) 100vw, 1312px"
		/>

		<h3 class="team__subheading">Meet the team</h3>

		<div class="team__grid">
			{
				team.map((person) => (
					<article class="team__card">
						<Image class="team__avatar" src={person.photo} alt={person.name} loading="lazy" widths={[220, 330, 440]} sizes="220px" />
						<p class="team__role">{person.role}</p>
						<p class="team__name">{person.name}</p>
						<p class="team__bio">{person.bio}</p>
					</article>
				))
			}

			<aside class="team__join">
				<p class="team__join-copy">
					And a wider team of specialists, creators and operators working in the trenches every
					day.
				</p>
				<div>
					<p class="team__join-label">
						Want to join us?
						<svg width="14" height="14" viewBox="0 0 35 36" fill="none" aria-hidden="true">
							<path d="M17 0V36" stroke="white" stroke-width="2" />
							<path d="M35 18H0" stroke="white" stroke-width="2" />
						</svg>
					</p>
					<a href="#" class="button button--white">Join our growing team</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.team__heading {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0 auto 48px;
	}

	.team__accent {
		color: var(--color-purple);
	}

	.team__banner {
		width: 100%;
		aspect-ratio: 1312 / 588;
		object-fit: cover;
		border-radius: var(--radius-card);
		margin-bottom: 56px;
	}

	.team__subheading {
		font-weight: 700;
		font-size: var(--font-size-h3);
		line-height: 0.9;
		margin: 0 0 24px;
	}

	.team__grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 16px;
	}

	/* Cards are ~250px wide by design (confirmed via get_design_context on
	   1502:8092). max-width is a hard cap so a card can never balloon to
	   fill its grid track — at narrower breakpoints the column count
	   drops, but the card itself stays compact instead of stretching. */
	.team__card {
		background: var(--color-text-invert);
		border-radius: var(--radius-card);
		box-shadow: 0 25px 100px 0 rgba(101, 8, 251, 0.15);
		padding: 15px;
		width: 100%;
		max-width: 260px;
		aspect-ratio: 250 / 408;
		display: flex;
		flex-direction: column;
		justify-self: center;
	}

	.team__avatar {
		aspect-ratio: 1;
		width: 100%;
		object-fit: cover;
		border-radius: 12px;
		margin-bottom: 16px;
	}

	.team__role {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-purple);
		margin: 0 0 6px;
	}

	.team__name {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 10px;
	}

	.team__bio {
		font-size: 14px;
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	.team__join {
		background: var(--color-purple);
		border-radius: var(--radius-card);
		padding: 20px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		color: var(--color-text-invert);
		width: 100%;
		max-width: 260px;
		aspect-ratio: 250 / 408;
		justify-self: center;
	}

	.team__join-copy {
		font-size: 14px;
		font-weight: 500;
		line-height: 1.5;
		margin: 0;
	}

	.team__join-label {
		font-size: 15px;
		font-weight: 700;
		margin: 0 0 12px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	/* Column count steps down gradually so cards shrink with the
	   viewport instead of jumping straight to 2 (which, with the
	   max-width cap above removed, used to blow cards up to roughly
	   half the page width on anything narrower than desktop). */
	@media (max-width: 1100px) {
		.team__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 700px) {
		.team__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 420px) {
		.team__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
