---
// Copy from Figma nodes 1502:8008/8015/8025. Collage photos and stat
// badges are the real exported assets from Daniel's About.zip
// (14 1.png, 113 1.png, 12 1.png → node names "14 1"/"113 1"/"12 1";
// Group 70/71/69.png are the pre-composited stat cards).
---

<section class="hero">
	<div class="container hero__grid">
		<div class="hero__copy">
			<p class="eyebrow">About</p>
			<h1>Built for <span class="hero__accent">creators.</span><br />Built to <span class="hero__accent">perform.</span></h1>
			<p class="hero__lede">
				SHOUT is the Creator Performance Platform built to change how brands and creators work
				together.
			</p>
		</div>

		<div class="hero__collage" aria-hidden="true">
			<img class="hero__photo hero__photo--a" src="/images/about/hero-photo-1.png" alt="" />
			<img class="hero__photo hero__photo--b" src="/images/about/hero-photo-2.png" alt="" />
			<img class="hero__photo hero__photo--c" src="/images/about/hero-photo-3.png" alt="" />

			<img class="hero__stat hero__stat--views" src="/images/about/stat-content-views.png" alt="14M+ Content Views" />
			<img class="hero__stat hero__stat--partnerships" src="/images/about/stat-creator-partnerships.png" alt="450+ Creator Partnerships" />
			<img class="hero__stat hero__stat--roi" src="/images/about/stat-roi.png" alt="312% Increase in ROI" />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: 64px;
		padding-bottom: 64px;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
	}

	h1 {
		font-weight: 700;
		font-size: clamp(2.5rem, 5vw, var(--font-size-h1));
		line-height: 0.9;
		letter-spacing: -1px;
		margin: 0 0 24px;
	}

	.hero__accent {
		color: var(--color-purple);
	}

	.hero__lede {
		font-weight: 600;
		font-size: var(--font-size-p-md);
		line-height: 1.5;
		color: var(--color-text-muted);
		max-width: 460px;
		margin: 0;
	}

	.hero__collage {
		position: relative;
		aspect-ratio: 646 / 561;
	}

	.hero__photo {
		position: absolute;
		border-radius: var(--radius-card);
		object-fit: cover;
	}

	.hero__photo--a {
		left: 0;
		top: 35%;
		width: 64%;
		height: 60%;
	}

	.hero__photo--b {
		right: 0;
		top: 0;
		width: 41%;
		height: 59%;
	}

	.hero__photo--c {
		right: 15%;
		bottom: 0;
		width: 44%;
		height: 40%;
	}

	.hero__stat {
		position: absolute;
		width: 27%;
		height: auto;
		filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.12));
	}

	.hero__stat--views {
		top: 0;
		right: 8%;
	}

	.hero__stat--partnerships {
		bottom: 8%;
		left: 40%;
		width: 32%;
	}

	.hero__stat--roi {
		bottom: 0;
		right: 0;
	}

	@media (max-width: 900px) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.hero__collage {
			display: none;
		}
	}
</style>
