---
// Copy from Figma nodes 1502:8008/8015/8025. Collage layout uses the exact
// left/top/width/height values from get_design_context on node 1505:4422
// "Group 73" (percentages there are relative to its own 646x561 box —
// converted here to % of that box for a fluid container). Photos and stat
// badges are the real exported assets from Daniel's About.zip.
---

<section class="hero">
	<div class="container hero__grid">
		<div class="hero__copy">
			<p class="eyebrow">About</p>
			<h1>Built for <span class="hero__accent">creators.</span><br />Built to <span class="hero__accent">perform.</span></h1>
			<p class="hero__lede">
				SHOUT is the Creator Performance Platform built to change how brands and creators work
				together.
			</p>
		</div>

		<div class="hero__collage" aria-hidden="true">
			<img class="hero__photo hero__photo--a" src="/images/about/hero-photo-1.png" alt="" />
			<img class="hero__photo hero__photo--b" src="/images/about/hero-photo-2.png" alt="" />
			<img class="hero__photo hero__photo--c" src="/images/about/hero-photo-3.png" alt="" />

			<img class="hero__stat hero__stat--views" src="/images/about/stat-content-views.png" alt="14M+ Content Views" />
			<img class="hero__stat hero__stat--partnerships" src="/images/about/stat-creator-partnerships.png" alt="450+ Creator Partnerships" />
			<img class="hero__stat hero__stat--roi" src="/images/about/stat-roi.png" alt="312% Increase in ROI" />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: 64px;
		padding-bottom: 120px;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
	}

	h1 {
		font-weight: 700;
		font-size: clamp(2.5rem, 5vw, var(--font-size-h1));
		line-height: 0.9;
		letter-spacing: -1px;
		margin: 0 0 24px;
	}

	.hero__accent {
		color: var(--color-purple);
	}

	.hero__lede {
		font-weight: 600;
		font-size: var(--font-size-p-md);
		line-height: 1.5;
		color: var(--color-text-muted);
		max-width: 460px;
		margin: 0;
	}

	/*
	  646x561 reference box (Group 73's own bounding box). Children are
	  positioned as % of that box, matching Figma's local left/top/width/
	  height exactly, so some legitimately bleed past 100% — that's the
	  real design, not a bug, so no overflow:hidden here.
	*/
	.hero__collage {
		position: relative;
		aspect-ratio: 646 / 561;
		margin-bottom: 60px;
	}

	.hero__photo {
		position: absolute;
		border-radius: var(--radius-card);
		object-fit: cover;
	}

	.hero__photo--a {
		left: 51.5%;
		top: 34.9%;
		width: 64.1%;
		height: 59.2%;
	}

	.hero__photo--b {
		left: 60.5%;
		top: 90.2%;
		width: 53.6%;
		height: 41.5%;
	}

	.hero__photo--c {
		left: 79.7%;
		top: 43.9%;
		width: 41.2%;
		height: 59.2%;
	}

	.hero__stat {
		position: absolute;
		height: auto;
		filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.1));
	}

	.hero__stat--views {
		left: 74.3%;
		top: 31.7%;
		width: 19.3%;
	}

	.hero__stat--partnerships {
		left: 57%;
		top: 90.2%;
		width: 26.3%;
	}

	.hero__stat--roi {
		left: 79.4%;
		top: 95.2%;
		width: 19.3%;
	}

	@media (max-width: 900px) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.hero__collage {
			display: none;
		}
	}
</style>
