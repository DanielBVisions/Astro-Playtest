---
import { Image } from 'astro:assets';
import heroPhoto1 from '../assets/about/hero-photo-1.png';
import heroPhoto2 from '../assets/about/hero-photo-2.png';
import heroPhoto3 from '../assets/about/hero-photo-3.png';

// Copy from Figma nodes 1502:8008/8015/8025. H1 uses the shared
// .section-heading style — confirmed 100px Bold Darker Grotesque via
// get_design_context on 1502:8015 itself, same token every other
// section heading on the page uses. Collage layout uses the exact
// left/top/width/height values from get_design_context on node 1505:4422
// "Group 73" — its calc(N% + Xpx) values are relative to the full 1440px
// canvas (verified: 14 1's calc(50%+10px) = 730 = Group 73's own canvas
// x), not its own 646px box as first assumed. Converted to canvas
// coordinates, then to local coordinates within Group 73 (subtracting its
// own x730/y178 origin), everything fits exactly inside the 646x561 box —
// two elements land flush on its right/bottom edges. Below are those
// local values as % of 646x561. Photos and stat badges are the real
// exported assets from Daniel's About.zip.
---

<section class="hero">
	<div class="container hero__grid">
		<div class="hero__copy">
			<p class="eyebrow">About</p>
			<h1 class="section-heading">Built for <span class="hero__accent">creators.</span><br />Built to <span class="hero__accent">perform.</span></h1>
			<p class="hero__lede">
				SHOUT is the Creator Performance Platform built to change how brands and creators work
				together.
			</p>
		</div>

		<div class="hero__collage" aria-hidden="true">
			<Image class="hero__photo hero__photo--a" src={heroPhoto1} alt="" loading="eager" fetchpriority="high" width={828} />
			<Image class="hero__photo hero__photo--b" src={heroPhoto2} alt="" loading="lazy" width={692} />
			<Image class="hero__photo hero__photo--c" src={heroPhoto3} alt="" loading="lazy" width={532} />

			<img class="hero__stat hero__stat--views" src="/images/about/stat-content-views.png" width="125" height="141" alt="14M+ Content Views" loading="lazy" />
			<img class="hero__stat hero__stat--partnerships" src="/images/about/stat-creator-partnerships.png" width="170" height="120" alt="450+ Creator Partnerships" loading="lazy" />
			<img class="hero__stat hero__stat--roi" src="/images/about/stat-roi.png" width="125" height="141" alt="312% Increase in ROI" loading="lazy" />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: 64px;
		padding-bottom: 64px;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
	}

	.hero__copy h1 {
		text-align: left;
		margin-bottom: 24px;
	}

	.hero__accent {
		color: var(--color-purple);
	}

	.hero__lede {
		font-weight: 600;
		font-size: var(--font-size-p-md);
		line-height: 1.5;
		color: var(--color-text-muted);
		max-width: 460px;
		margin: 0;
	}

	.hero__collage {
		position: relative;
		aspect-ratio: 646 / 561;
	}

	.hero__photo {
		position: absolute;
		border-radius: var(--radius-card);
		object-fit: cover;
	}

	.hero__photo--a {
		left: 0%;
		top: 3.2%;
		width: 64.1%;
		height: 59.2%;
	}

	.hero__photo--b {
		left: 19.2%;
		top: 58.5%;
		width: 53.6%;
		height: 41.5%;
	}

	.hero__photo--c {
		left: 58.8%;
		top: 12.1%;
		width: 41.2%;
		height: 59.2%;
	}

	.hero__stat {
		position: absolute;
		height: auto;
		filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.1));
	}

	.hero__stat--views {
		left: 53.4%;
		top: 0%;
		width: 19.3%;
	}

	.hero__stat--partnerships {
		left: 5.4%;
		top: 58.5%;
		width: 26.3%;
	}

	.hero__stat--roi {
		left: 68.7%;
		top: 63.5%;
		width: 19.3%;
	}

	@media (max-width: 900px) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.hero__collage {
			display: none;
		}
	}
</style>
