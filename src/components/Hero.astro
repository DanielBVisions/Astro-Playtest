---
// Copy verbatim from Figma nodes 1502:8008/8015/8025 (hero text) and
// 1505:4422 "Group 73" (get_design_context — stat badges: 14M+ Content
// Views, 450+ Creator Partnerships, 312% Increase in ROI). The collage
// photos themselves aren't reproduced — no photo assets were downloadable
// this session — so they're placeholder gradient blocks in roughly the
// original composition.
---

<section class="hero">
	<div class="container hero__grid">
		<div class="hero__copy">
			<p class="eyebrow">About</p>
			<h1>Built for <span class="hero__accent">creators.</span><br />Built to <span class="hero__accent">perform.</span></h1>
			<p class="hero__lede">
				SHOUT is the Creator Performance Platform built to change how brands and creators work
				together.
			</p>
		</div>

		<div class="hero__collage" aria-hidden="true">
			<div class="hero__photo hero__photo--a"></div>
			<div class="hero__photo hero__photo--b"></div>
			<div class="hero__photo hero__photo--c"></div>

			<div class="hero__stat hero__stat--views">
				<p class="hero__stat-number">14M+</p>
				<p class="hero__stat-label">Content Views</p>
			</div>
			<div class="hero__stat hero__stat--partnerships">
				<p class="hero__stat-number">450+</p>
				<p class="hero__stat-label">Creator Partnerships</p>
			</div>
			<div class="hero__stat hero__stat--roi">
				<p class="hero__stat-number">312%</p>
				<p class="hero__stat-label">Increase in ROI</p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: 64px;
		padding-bottom: 64px;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
	}

	h1 {
		font-weight: 700;
		font-size: clamp(2.5rem, 5vw, var(--font-size-h1));
		line-height: 0.9;
		letter-spacing: -1px;
		margin: 0 0 24px;
	}

	.hero__accent {
		color: var(--color-purple);
	}

	.hero__lede {
		font-weight: 600;
		font-size: var(--font-size-p-md);
		line-height: 1.5;
		color: var(--color-text-muted);
		max-width: 460px;
		margin: 0;
	}

	.hero__collage {
		position: relative;
		aspect-ratio: 646 / 561;
	}

	.hero__photo {
		position: absolute;
		border-radius: var(--radius-card);
		background: linear-gradient(135deg, var(--color-purple), var(--color-pink));
		opacity: 0.85;
	}

	.hero__photo--a {
		left: 0;
		top: 35%;
		width: 64%;
		height: 60%;
	}

	.hero__photo--b {
		right: 0;
		top: 0;
		width: 41%;
		height: 59%;
		opacity: 0.65;
	}

	.hero__photo--c {
		right: 15%;
		bottom: 0;
		width: 54%;
		height: 40%;
		opacity: 0.5;
	}

	.hero__stat {
		position: absolute;
		background: var(--color-text-invert);
		border-radius: var(--radius-card);
		padding: 18px 20px;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
	}

	.hero__stat-number {
		font-weight: 600;
		font-size: var(--font-size-h4);
		line-height: 0.9;
		color: var(--color-purple);
		margin: 0 0 4px;
	}

	.hero__stat-label {
		font-weight: 600;
		font-size: var(--font-size-p-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
		margin: 0;
	}

	.hero__stat--views {
		top: 0;
		right: 8%;
	}

	.hero__stat--partnerships {
		bottom: 8%;
		left: 40%;
	}

	.hero__stat--roi {
		bottom: 0;
		right: 0;
	}

	@media (max-width: 900px) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.hero__collage {
			display: none;
		}
	}
</style>
