---
// Copy verbatim from Figma node 1502:7948 "Footer" (get_design_context).
const columns = [
	{
		heading: 'PLATFORM',
		links: ['SHOUT Studio', 'SHOUT Plus', 'Pricing'],
		arrowLinks: ['Login'],
	},
	{
		heading: 'RESOURCES',
		links: ['Success stories', 'ROI calculator', 'Blogs', 'What is UGC?', 'FAQs'],
	},
	{
		heading: 'COMPANY',
		links: ['About us', 'Careers', 'Contact', 'For Creators'],
		arrowLinks: ['SHOUT Agency', 'Unitaskr'],
	},
	{
		heading: 'SOLUTIONS',
		links: ['Scale creator content', 'Drive performance', 'Automate operations', 'Optimise & learn', 'Activate customers'],
	},
];
---

<footer class="footer">
	<div class="container">
		<div class="footer__top">
			<div class="footer__brand">
				<p class="footer__logo">SHOUT</p>
				<div class="footer__contact">
					<p class="footer__contact-label">CONTACT US</p>
					<p class="footer__contact-email">hello@shoutugc.com</p>
				</div>
			</div>

			<div class="footer__columns">
				{
					columns.map((column) => (
						<div>
							<p class="footer__heading">{column.heading}</p>
							<ul>
								{column.links.map((link) => (
									<li><a href="#">{link}</a></li>
								))}
								{column.arrowLinks?.map((link) => (
									<li>
										<a href="#" class="footer__arrow-link">
											{link}
											<svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
												<path d="M1 9 9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<div class="footer__social">
			<a href="#" aria-label="Instagram"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="17.3" cy="6.7" r="1.1" /></svg></a>
			<a href="#" aria-label="X"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></a>
			<a href="#" aria-label="YouTube"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.6" /><path d="M10 9l6 3-6 3V9Z" fill="currentColor" /></svg></a>
			<a href="#" aria-label="LinkedIn"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="4" stroke="currentColor" stroke-width="1.6" /><circle cx="7.5" cy="7.5" r="1.3" fill="currentColor" /><path d="M7.5 11v7M11.5 18v-4.5c0-1.5 1-2.5 2.5-2.5s2.5 1 2.5 2.5V18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></a>
		</div>

		<hr class="footer__divider" />

		<div class="footer__bottom">
			<div class="footer__legal-left">
				<p>&copy; 2026 UNIDOSH LTD, Inc. All rights reserved.</p>
				<p>Design by Visions</p>
			</div>
			<div class="footer__legal-right">
				<a href="#">Terms</a>
				<a href="#">Privacy policy</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-text-invert);
		padding-block: 64px 32px;
	}

	.footer__top {
		display: flex;
		justify-content: space-between;
		gap: 48px;
		margin-bottom: 46px;
		flex-wrap: wrap;
	}

	.footer__brand {
		display: flex;
		flex-direction: column;
		gap: 52px;
	}

	.footer__logo {
		font-weight: 800;
		font-size: 28px;
		letter-spacing: -0.5px;
	}

	.footer__contact {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 202px;
	}

	.footer__contact-label,
	.footer__heading {
		font-weight: 700;
		font-size: var(--font-size-p-sm);
	}

	.footer__contact-email {
		font-weight: 600;
		font-size: var(--font-size-p-sm);
		color: var(--color-text-muted);
	}

	.footer__columns {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
	}

	.footer__columns > div {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 202px;
	}

	.footer__columns ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.footer__columns a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: var(--font-size-p-sm);
		font-weight: 600;
	}

	.footer__columns a:hover {
		color: var(--color-purple);
	}

	.footer__arrow-link {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.footer__social {
		display: flex;
		gap: 12px;
		margin-bottom: 16px;
		color: var(--color-text);
	}

	.footer__social a {
		color: inherit;
		display: flex;
	}

	.footer__divider {
		border: none;
		border-top: 1px solid #eee;
		margin: 0 0 16px;
	}

	.footer__bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.footer__legal-left,
	.footer__legal-right {
		display: flex;
		gap: 16px;
		align-items: center;
	}

	.footer__legal-left p,
	.footer__legal-right a {
		font-size: var(--font-size-p-sm);
		font-weight: 600;
		color: var(--color-text-muted);
		margin: 0;
		text-decoration: none;
	}

	@media (max-width: 720px) {
		.footer__top {
			flex-direction: column;
		}
	}
</style>
