<section class="cta">
	<div class="container cta__inner">
		<h2>
			Build the future<br />
			of creator marketing.
		</h2>
		<p>We're always looking for builders, thinkers, and doers who want to create real impact.</p>
		<a href="#" class="button button--white">Join our growing team</a>
	</div>
</section>

<style>
	.cta {
		padding-block: 0 96px;
	}

	.cta__inner {
		background: linear-gradient(135deg, #2a2a2a, #050505);
		border-radius: var(--radius-card);
		padding: 80px 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		text-align: center;
	}

	.cta h2 {
		font-weight: 600;
		font-size: clamp(2.25rem, 6vw, var(--font-size-h1));
		line-height: 0.8;
		letter-spacing: -1px;
		color: var(--color-text-invert);
	}

	.cta p {
		font-weight: 600;
		font-size: var(--font-size-h5);
		line-height: 1.4;
		color: var(--color-text-invert-muted);
		max-width: 500px;
		margin: 0;
	}
</style>
