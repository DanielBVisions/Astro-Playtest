---
// Copy verbatim from Figma node 1505:4423. The ribbon graphic either side
// (nodes 1502:6088 / 1502:7005) is the real exported asset (Group.png,
// mirrored for the right side to match the two-frame layout in Figma).
---

<section class="mission">
	<img class="mission__ribbon mission__ribbon--left" src="/images/about/mission-ribbon.png" alt="" aria-hidden="true" />
	<img class="mission__ribbon mission__ribbon--right" src="/images/about/mission-ribbon.png" alt="" aria-hidden="true" />

	<div class="container mission__inner">
		<h2>
			Creator marketing<br />
			is broken. <span class="mission__accent">We&rsquo;re here to fix it.</span>
		</h2>
		<p class="mission__lede">
			Our mission is to replace vanity metrics, bloated processes and guesswork with a smarter
			model — connecting the right creators with the right brands and turning authentic content
			into measurable growth.
		</p>
	</div>
</section>

<style>
	.mission {
		position: relative;
		overflow: hidden;
		text-align: center;
	}

	.mission__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 40px;
	}

	h2 {
		font-weight: 700;
		font-size: clamp(2.5rem, 7vw, var(--font-size-display));
		line-height: 0.8;
		letter-spacing: -1px;
		max-width: 900px;
	}

	.mission__accent {
		color: var(--color-purple);
	}

	.mission__lede {
		font-weight: 600;
		font-size: var(--font-size-h5);
		line-height: 1.4;
		color: var(--color-text-muted);
		max-width: 710px;
		margin: 0;
	}

	.mission__ribbon {
		position: absolute;
		width: 340px;
		z-index: 0;
		opacity: 0.9;
	}

	.mission__ribbon--left {
		left: -140px;
		top: -40px;
	}

	.mission__ribbon--right {
		right: -140px;
		bottom: -60px;
		transform: scaleX(-1);
	}

	@media (max-width: 700px) {
		.mission__ribbon {
			width: 220px;
		}
	}
</style>
