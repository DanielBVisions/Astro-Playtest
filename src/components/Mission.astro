---
import { Image } from 'astro:assets';
import ribbon from '../assets/about/mission-ribbon.png';

// Copy verbatim from Figma node 1505:4423. Heading now uses the shared
// .section-heading style (confirmed 100px Bold Darker Grotesque via
// get_design_context on sibling heading nodes 1502:8016/8019 — every
// section heading on this page uses the same size, this one included).
// The ribbon graphic either side (nodes 1502:6088 / 1502:7005) is the
// real exported asset (Group.png, mirrored for the right side to match
// the two-frame layout in Figma).
---

<section class="mission">
	<Image class="mission__ribbon mission__ribbon--left" src={ribbon} alt="" aria-hidden="true" loading="lazy" width={680} />
	<Image class="mission__ribbon mission__ribbon--right" src={ribbon} alt="" aria-hidden="true" loading="lazy" width={680} />

	<div class="mission__glow" aria-hidden="true"></div>

	<div class="container mission__inner">
		<h2 class="section-heading mission__heading">
			Creator marketing<br />
			is broken. <span class="mission__accent">We&rsquo;re here to fix it.</span>
		</h2>
		<p class="mission__lede">
			Our mission is to replace vanity metrics, bloated processes and guesswork with a smarter
			model — connecting the right creators with the right brands and turning authentic content
			into measurable growth.
		</p>
	</div>
</section>

<style>
	.mission {
		position: relative;
		text-align: center;
		/* Taller than the default section padding so the ribbon graphics
		   (which extend well past the text block) have room without
		   needing overflow:hidden to clip them. */
		padding-block: 160px;
	}

	.mission__glow {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 900px;
		height: 900px;
		transform: translate(-50%, -50%);
		background: radial-gradient(circle, rgba(101, 8, 251, 0.18) 0%, rgba(101, 8, 251, 0) 70%);
		z-index: 0;
		pointer-events: none;
	}

	.mission__inner {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 40px;
	}

	.mission__heading {
		max-width: 900px;
		margin-bottom: 0;
	}

	.mission__accent {
		color: var(--color-purple);
	}

	.mission__lede {
		font-weight: 600;
		font-size: var(--font-size-h5);
		line-height: 1.4;
		color: var(--color-text-muted);
		max-width: 710px;
		margin: 0;
	}

	.mission__ribbon {
		position: absolute;
		width: 340px;
		z-index: 1;
		opacity: 0.9;
	}

	/*
	  Figma's canvas coordinates (node 1502:7005 right ribbon at y=799 vs
	  node 1502:6088 left ribbon at y=1095) put the right ribbon near the
	  section top and the left ribbon roughly a third of the way down —
	  not mirrored top/bottom.
	*/
	.mission__ribbon--left {
		left: -140px;
		top: 32%;
	}

	.mission__ribbon--right {
		right: -140px;
		top: -30px;
		transform: scaleX(-1);
	}

	@media (max-width: 700px) {
		.mission {
			padding-block: 100px;
		}

		.mission__ribbon {
			width: 220px;
		}

		.mission__glow {
			width: 600px;
			height: 600px;
		}
	}
</style>
