---
// Copy from Figma nodes 1502:8016, 1502:8067, 1502:8062-64, 1502:8071-73.
// Icon glyphs are the exact paths from Daniel's About.zip: Vector.svg
// (bolt), Group 49.svg (bar chart), Group.svg (heart) — matching nodes
// 1502:8074/8082/8077.
const pillars = [
	{
		icon: 'bolt',
		title: 'Real creators. Real impact.',
		body: 'We champion authentic creators who drive real influence-not just inflated numbers. Quality over quantity, always.',
	},
	{
		icon: 'chart',
		title: 'Performance at scale.',
		body: 'Our platform combines data, automation and human expertise to run creator campaigns that deliver measurable business results.',
	},
	{
		icon: 'heart',
		title: 'Culture first. Always.',
		body: 'We stay close to internet culture so our campaigns feel native, not forced. Built with creators, for creators.',
	},
];
---

<section class="pillars">
	<div class="container">
		<div class="pillars__heading">
			<h2 class="section-heading">Our ethos. <span class="pillars__accent">Built on three pillars.</span></h2>
			<p class="section-lede">
				SHOUT was built to bridge the gap between enterprise performance and the creator economy.
				This is how we do it.
			</p>
		</div>

		<div class="pillars__grid">
			{
				pillars.map((pillar) => (
					<article class="pillars__card">
						<span class="pillars__icon">
							{pillar.icon === 'bolt' && (
								<svg width="16" height="20" viewBox="0 0 32 40" fill="none" aria-hidden="true">
									<path
										d="M21.3333 1.81827C21.3333 1.05278 20.8645 0.369289 20.1607 0.10869C19.457 -0.151902 18.669 0.0662356 18.1898 0.654306L0.412073 22.4725C-0.0295261 23.0145 -0.124726 23.7686 0.16786 24.4076C0.460446 25.0465 1.08798 25.4546 1.7778 25.4546H10.6667V38.1819C10.6667 38.9473 11.1355 39.6308 11.8393 39.8913C12.5431 40.1519 13.331 39.9339 13.8101 39.3457L31.5879 17.5276C32.0295 16.9858 32.1248 16.2314 31.8321 15.5925C31.5395 14.9536 30.912 14.5455 30.2222 14.5455H21.3333V1.81827Z"
										fill="white"
									/>
								</svg>
							)}
							{pillar.icon === 'chart' && (
								<svg width="16" height="16" viewBox="0 0 31 31" fill="none" aria-hidden="true">
									<rect y="20" width="9" height="11" rx="2" fill="white" />
									<rect x="11" y="11" width="9" height="20" rx="2" fill="white" />
									<rect x="22" width="9" height="31" rx="2" fill="white" />
								</svg>
							)}
							{pillar.icon === 'heart' && (
								<svg width="18" height="16" viewBox="0 0 39 35" fill="none" aria-hidden="true">
									<path
										d="M28.4133 0C26.3138 0 24.389 0.665291 22.6923 1.97743C21.0658 3.2354 19.9828 4.83764 19.3453 6.00273C18.7077 4.83757 17.6247 3.2354 15.9982 1.97743C14.3015 0.665291 12.3767 0 10.2772 0C4.41837 0 0.00012207 4.79223 0.00012207 11.1472C0.00012207 18.0127 5.5122 22.71 13.8568 29.8211C15.2738 31.0288 16.88 32.3976 18.5494 33.8575C18.7694 34.0501 19.0521 34.1562 19.3453 34.1562C19.6385 34.1562 19.9211 34.0501 20.1411 33.8575C21.8107 32.3974 23.4168 31.0287 24.8347 29.8204C33.1783 22.71 38.6904 18.0127 38.6904 11.1472C38.6904 4.79223 34.2721 0 28.4133 0Z"
										fill="white"
									/>
								</svg>
							)}
						</span>
						<h3>{pillar.title}</h3>
						<p>{pillar.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.pillars__heading {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0 auto 56px;
		max-width: 640px;
	}

	.pillars__accent {
		color: var(--color-purple);
	}

	.pillars__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.pillars__card {
		background: var(--color-surface);
		border-radius: var(--radius-card);
		padding: 40px 32px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.pillars__icon {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--color-purple);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
	}

	.pillars__card h3 {
		font-weight: 700;
		font-size: 22px;
		margin: 0 0 12px;
	}

	.pillars__card p {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.6;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 900px) {
		.pillars__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
