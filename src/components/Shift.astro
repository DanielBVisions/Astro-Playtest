---
// Copy from Figma nodes 1502:8009, 1502:8018, 1502:8068, plus the numbered
// step labels/headings/bodies (1502:8012-14, 1502:8022-24, 1502:8056-61).
// The exact left/right pairing of "THE OLD WAY" / "THE PROBLEM" / "THE SHIFT"
// couldn't be confirmed from layout coordinates alone (Figma disconnected
// before a full design-context read) — ordered here as a logical progression.
const steps = [
	{
		number: '01',
		label: 'The old way',
		title: 'Built on vanity. Blind to impact.',
		body: 'Follower counts. Outdated benchmarks. Manual processes. Zero visibility.',
	},
	{
		number: '02',
		label: 'The problem',
		title: 'Waste. Missed matches. No clarity.',
		body: 'Brands overpay. Creators get overlooked. Everyone loses.',
	},
	{
		number: '03',
		label: 'The shift',
		title: 'Data-powered. Creator-led. Outcome obsessed.',
		body: 'Smart matching. Real-time insights. Proven results at scale.',
	},
];
---

<section class="shift">
	<div class="container">
		<p class="eyebrow">The shift</p>
		<h2>From guesswork to guaranteed growth.</h2>
		<p class="shift__lede">We didn't tweak the old system. We built a new one.</p>

		<ol class="shift__steps">
			{
				steps.map((step) => (
					<li class="shift__step">
						<div class="shift__marker">
							<span class="shift__number">{step.number}</span>
							<span class="shift__dot" aria-hidden="true" />
						</div>
						<div class="shift__content">
							<p class="shift__label">{step.label}</p>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		margin: 0 0 16px;
		max-width: 640px;
	}

	.shift__lede {
		font-size: 16px;
		color: var(--color-text-muted);
		max-width: 560px;
		margin: 0 0 56px;
	}

	.shift__steps {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--color-border);
		max-width: 640px;
	}

	.shift__step {
		display: flex;
		gap: 24px;
		padding-bottom: 48px;
		position: relative;
	}

	.shift__step:last-child {
		padding-bottom: 0;
	}

	.shift__marker {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		margin-left: -1px;
	}

	.shift__number {
		font-size: 14px;
		font-weight: 700;
		color: var(--color-text-muted);
		width: 28px;
		flex-shrink: 0;
	}

	.shift__dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--color-accent);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.shift__content {
		padding-left: 8px;
	}

	.shift__label {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 8px;
	}

	.shift__content h3 {
		font-size: 18px;
		font-weight: 700;
		margin: 0 0 8px;
	}

	.shift__content p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-text-muted);
		margin: 0;
	}
</style>
