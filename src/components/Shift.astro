---
// Copy and layout confirmed from Figma nodes 1502:8009/8018/8068 (section
// heading), 1502:8012-14 (row labels), 1502:8022-24 (numerals, 100px
// Darker Grotesque Bold, solid purple — node 1502:8022 fetched directly),
// 1502:8056-8061 (row headings/bodies). Row x-coordinates confirm the
// alternating left/right layout: row 1 and 3 content sit right of the
// centre line (numeral left), row 2 sits left (numeral right).
const steps = [
	{
		number: '01',
		label: 'The old way',
		title: 'Built on vanity. Blind to impact.',
		body: 'Follower counts. Outdated benchmarks. Manual processes. Zero visibility.',
		side: 'right',
	},
	{
		number: '02',
		label: 'The problem',
		title: 'Waste. Missed matches. No clarity.',
		body: 'Brands overpay. Creators get overlooked. Everyone loses.',
		side: 'left',
	},
	{
		number: '03',
		label: 'The shift',
		title: 'Data-powered. Creator-led. Outcome obsessed.',
		body: 'Smart matching. Real-time insights. Proven results at scale.',
		side: 'right',
	},
];
---

<section class="shift">
	<div class="container">
		<div class="shift__heading">
			<p class="eyebrow">The shift</p>
			<h2 class="section-heading">From guesswork to <span class="shift__accent">guaranteed growth.</span></h2>
			<p class="section-lede">We didn't tweak the old system. We built a new one.</p>
		</div>

		<div class="shift__timeline-wrap">
			<div class="shift__line" aria-hidden="true">
				<div class="shift__line-fill"></div>
			</div>
			<ol class="shift__timeline">
				{
					steps.map((step) => {
						const number = <span class="shift__number">{step.number}</span>;
						const content = (
							<div class="shift__content">
								<p class="shift__label">{step.label}</p>
								<h3>{step.title}</h3>
								<p class="shift__body">{step.body}</p>
							</div>
						);
						return (
							<li class={`shift__row shift__row--${step.side}`}>
								<span class="shift__dot" aria-hidden="true"></span>
								{step.side === 'left' ? (
									<>
										{content}
										{number}
									</>
								) : (
									<>
										{number}
										{content}
									</>
								)}
							</li>
						);
					})
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.shift__heading {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0 auto 64px;
	}

	.shift__accent {
		color: var(--color-purple);
	}

	.shift__timeline-wrap {
		max-width: 900px;
		margin-inline: auto;
		position: relative;
	}

	.shift__timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Static track + a scroll-scrubbed fill (src/scripts/animations.js
	   scales .shift__line-fill's height from 0 to 100% as the timeline
	   scrolls through view). */
	.shift__line {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 1px;
		background: #e5e5e5;
		transform: translateX(-50%);
	}

	.shift__line-fill {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background: var(--color-purple);
		transform-origin: top;
		transform: scaleY(0);
	}

	.shift__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		/* start, not center: with center, row 2's much-shorter content
		   block was centering against the *taller* of its own two grid
		   items in a way that put it well below the numeral instead of
		   alongside it. start pins both to the row's top edge, which is
		   consistent regardless of how tall the numeral vs. content is. */
		align-items: start;
		gap: 40px;
		padding-block: 32px;
		position: relative;
		/* Full opacity by default (no-JS fallback). JS
		   (src/scripts/animations.js, initTimelineScroll) dims rows to 40%
		   until they're centered in view, once it confirms it can run the
		   interaction — never left permanently dim if JS fails to load. */
		opacity: 1;
	}

	.shift__dot {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--color-purple);
		z-index: 1;
	}

	.shift__number {
		font-weight: 700;
		font-size: clamp(3rem, 8vw, var(--font-size-display));
		line-height: 0.8;
		letter-spacing: -1px;
		color: var(--color-purple);
	}

	/* No grid-column overrides: the markup itself puts content before the
	   number for "left" rows and after it for "right" rows, so column
	   placement just follows natural DOM order — grid-column swapping
	   here was the suspected cause of row 2 (side: left) rendering its
	   content well below the numeral instead of alongside it. */
	.shift__row--right .shift__number {
		text-align: right;
	}

	.shift__row--right .shift__content {
		text-align: left;
	}

	.shift__row--left .shift__content {
		text-align: right;
	}

	.shift__row--left .shift__number {
		text-align: left;
	}

	.shift__label {
		font-weight: 600;
		font-size: var(--font-size-p-md);
		color: var(--color-purple);
		margin: 0 0 8px;
	}

	.shift__content h3 {
		font-weight: 700;
		font-size: 22px;
		margin: 0 0 8px;
	}

	.shift__body {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.6;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 700px) {
		.shift__line {
			left: 4px;
		}

		.shift__dot {
			left: 4px;
		}

		.shift__row {
			grid-template-columns: 40px 1fr;
			gap: 16px;
		}

		/* Mobile always shows number-then-content left to right, regardless
		   of the left/right DOM order used for desktop's alternating
		   layout — order overrides that without needing grid-column. */
		.shift__number {
			order: 1;
			text-align: left;
			font-size: 2rem;
		}

		.shift__row--right .shift__content,
		.shift__row--left .shift__content {
			order: 2;
			text-align: left;
		}
	}
</style>
