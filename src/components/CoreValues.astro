---
// Copy verbatim from Figma nodes 1502:8010/8019/8069 (heading) and the six
// card nodes 1502:8026/8031/8036/8041/8046/8051 (get_design_context).
// Three cards use a solid purple fill (#6508fb); the other three use a
// dark gradient photo background (value-card-bg.png, the real export for
// node 1502:8041 "Frame 1948758621" / Performance Obsession). Only that
// one card's background image was in Daniel's About.zip, so it's reused
// for Move Fast and Global Mindset too — same treatment in the design.
const values = [
	{
		title: 'Creator First',
		subtitle: 'We start with people.',
		body: ["Creators aren't just inventory.", 'We partner with real people and build relationships that last.'],
		variant: 'purple',
	},
	{
		title: 'Performance Obsession',
		subtitle: 'We care about what moves the needle.',
		body: ['We measure what matters and obsess over outcomes that drive real business impact.'],
		variant: 'photo',
	},
	{
		title: 'Built on Trust',
		subtitle: 'We do what we say.',
		body: ['Transparency, honesty and reliability power everything we do - with creators, brands and each other.'],
		variant: 'purple',
	},
	{
		title: 'Move Fast',
		subtitle: 'Momentum is our advantage.',
		body: ['We move quickly, test constantly, and ship solutions that keep our customers ahead.'],
		variant: 'photo',
	},
	{
		title: 'One Team',
		subtitle: 'We win together.',
		body: ['No silos. No ego. We collaborate across every function to create extraordinary results.'],
		variant: 'purple',
	},
	{
		title: 'Global Mindset',
		subtitle: 'We think bigger.',
		body: ['We combine local culture with global scale to help creators and brands break borders.'],
		variant: 'photo',
	},
];
---

<section class="values">
	<div class="container">
		<div class="values__heading">
			<p class="eyebrow">Core values</p>
			<h2 class="section-heading">What drives us. <span class="values__accent">Every day.</span></h2>
			<p class="section-lede">
				These values shape how we build, how we partner, and how we win - together.
			</p>
		</div>

		<div class="values__grid">
			{
				values.map((value) => (
					<article class={`values__card values__card--${value.variant}`}>
						<h3>{value.title}</h3>
						<p class="values__subtitle">{value.subtitle}</p>
						<div class="values__body">
							{value.body.map((line) => (
								<p>{line}</p>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.values {
		background: var(--color-black);
		color: var(--color-text-invert);
	}

	.values__heading {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0 auto 56px;
		max-width: 640px;
	}

	.values .section-heading {
		color: var(--color-text-invert);
	}

	.values__accent {
		color: var(--color-purple);
	}

	.values .section-lede {
		color: var(--color-text-invert-muted);
	}

	.values__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.values__card {
		border-radius: var(--radius-card);
		padding: 24px;
		aspect-ratio: 424 / 247;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 16px;
	}

	.values__card--purple {
		background: var(--color-purple);
	}

	.values__card--photo {
		background:
			linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.55) 100%),
			url('/images/about/value-card-bg.png');
		background-size: cover;
		background-position: center;
	}

	.values__card h3 {
		font-weight: 600;
		font-size: var(--font-size-h3);
		line-height: 0.8;
		letter-spacing: -1px;
	}

	.values__subtitle {
		font-weight: 600;
		font-size: var(--font-size-h5);
		line-height: 0.9;
	}

	.values__body {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.85);
	}

	.values__body p {
		margin: 0;
	}

	@media (max-width: 900px) {
		.values__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 600px) {
		.values__grid {
			grid-template-columns: 1fr;
		}

		.values__card {
			aspect-ratio: auto;
			min-height: 220px;
		}
	}
</style>
