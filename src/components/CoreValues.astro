---
import { getImage } from 'astro:assets';
import valueCardBgSrc from '../assets/about/value-card-bg.png';

const valueCardBg = await getImage({ src: valueCardBgSrc, width: 900, format: 'webp' });

// Copy verbatim from Figma nodes 1502:8010/8019/8069 (heading) and the six
// card nodes 1502:8026/8031/8036/8041/8046/8051 (get_design_context).
// Section background is white/default, NOT black — confirmed via
// get_design_context on 1502:8019 (heading uses text/primary = black)
// and 1502:8069 (lede uses text/secondary = #666), both of which only
// make sense on a light background. The black/dark look in the design
// comes entirely from the cards themselves: three solid purple
// (#6508fb), three a dark gradient photo (value-card-bg.png, the real
// export for node 1502:8041 "Frame 1948758621" / Performance Obsession,
// reused for Move Fast and Global Mindset since only one photo card was
// in Daniel's About.zip).
const values = [
	{
		title: 'Creator First',
		subtitle: 'We start with people.',
		body: ["Creators aren't just inventory.", 'We partner with real people and build relationships that last.'],
		variant: 'purple',
	},
	{
		title: 'Performance Obsession',
		subtitle: 'We care about what moves the needle.',
		body: ['We measure what matters and obsess over outcomes that drive real business impact.'],
		variant: 'photo',
	},
	{
		title: 'Built on Trust',
		subtitle: 'We do what we say.',
		body: ['Transparency, honesty and reliability power everything we do - with creators, brands and each other.'],
		variant: 'purple',
	},
	{
		title: 'Move Fast',
		subtitle: 'Momentum is our advantage.',
		body: ['We move quickly, test constantly, and ship solutions that keep our customers ahead.'],
		variant: 'photo',
	},
	{
		title: 'One Team',
		subtitle: 'We win together.',
		body: ['No silos. No ego. We collaborate across every function to create extraordinary results.'],
		variant: 'purple',
	},
	{
		title: 'Global Mindset',
		subtitle: 'We think bigger.',
		body: ['We combine local culture with global scale to help creators and brands break borders.'],
		variant: 'photo',
	},
];
---

<section class="values">
	<div class="container">
		<div class="values__heading">
			<p class="eyebrow">Core values</p>
			<h2 class="section-heading">What drives us. <span class="values__accent">Every day.</span></h2>
			<p class="section-lede">
				These values shape how we build, how we partner, and how we win - together.
			</p>
		</div>

		<div class="values__grid">
			{
				values.map((value) => (
					<article
						class={`values__card values__card--${value.variant}`}
						style={value.variant === 'photo' ? `--card-bg: url(${valueCardBg.src})` : undefined}
					>
						<h3>{value.title}</h3>
						<p class="values__subtitle">{value.subtitle}</p>
						<div class="values__body">
							{value.body.map((line) => (
								<p>{line}</p>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.values__heading {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0 auto 56px;
	}

	.values__accent {
		color: var(--color-purple);
	}

	.values__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.values__card {
		border-radius: var(--radius-card);
		padding: 24px;
		aspect-ratio: 424 / 247;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 16px;
		/* Card text is white regardless of the page's white section bg —
		   confirmed via get_design_context: card content uses
		   text-invert/primary. Lost when the section-level white text
		   color was removed along with the (wrong) black section bg. */
		color: var(--color-text-invert);
	}

	.values__card--purple {
		background: var(--color-purple);
	}

	.values__card--photo {
		/* --card-bg (the optimized asset URL) is set inline per-card, since
		   Astro's image pipeline only processes <Image>/getImage output,
		   not literal CSS url() paths. */
		background-color: #111111;
		background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.55) 100%), var(--card-bg, none);
		background-size: cover;
		background-position: center;
	}

	.values__card h3 {
		font-weight: 600;
		font-size: var(--font-size-h3);
		line-height: 0.8;
		letter-spacing: -1px;
	}

	.values__subtitle {
		font-weight: 600;
		font-size: var(--font-size-h5);
		line-height: 0.9;
	}

	.values__body {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.85);
	}

	.values__body p {
		margin: 0;
	}

	@media (max-width: 900px) {
		.values__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 600px) {
		.values__grid {
			grid-template-columns: 1fr;
		}

		.values__card {
			aspect-ratio: auto;
			min-height: 220px;
		}
	}
</style>
