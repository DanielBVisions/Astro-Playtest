---
// Heading copy from Figma nodes 1502:8010, 1502:8019, 1502:8069.
// The six value-card titles/descriptions (frames 1502:8026-8051) sit deeper
// than this session's metadata read reached, so these are PLACEHOLDERS —
// swap in the real card copy once Figma is reconnected.
const values = [
	{ title: 'Creators first', body: 'Every decision starts with what actually helps creators grow.' },
	{ title: 'Radical transparency', body: 'Clear data, honest numbers, no vanity metrics.' },
	{ title: 'Move with speed', body: 'We ship fast and iterate faster than the market moves.' },
	{ title: 'Ownership', body: 'We act like founders, not employees, in everything we build.' },
	{ title: 'Craft over shortcuts', body: 'Quality is non-negotiable, even under pressure.' },
	{ title: 'Outcomes over effort', body: 'We measure ourselves by results, not activity.' },
];
---

<section class="values">
	<div class="container">
		<p class="eyebrow">Core values</p>
		<h2>What drives us. Every day.</h2>
		<p class="values__lede">
			These values shape how we build, how we partner, and how we win - together.
		</p>

		<div class="values__grid">
			{
				values.map((value) => (
					<article class="values__card">
						<h3>{value.title}</h3>
						<p>{value.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		margin: 0 0 16px;
		max-width: 640px;
	}

	.values__lede {
		font-size: 16px;
		color: var(--color-text-muted);
		max-width: 560px;
		margin: 0 0 56px;
	}

	.values__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.values__card {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 28px;
	}

	.values__card h3 {
		font-size: 17px;
		font-weight: 700;
		margin: 0 0 10px;
	}

	.values__card p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 900px) {
		.values__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 600px) {
		.values__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
