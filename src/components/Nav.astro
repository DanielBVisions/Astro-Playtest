---
/* Placeholder nav — the frame includes a top bar (node 1502:7932) but its
   link labels weren't readable from the metadata this session pulled. */
const links = ['Home', 'About', 'Creators', 'Brands', 'Contact'];
---

<header class="nav">
	<div class="container nav__inner">
		<a href="/" class="nav__logo">SHOUT</a>
		<nav>
			<ul class="nav__links">
				{links.map((label) => (
					<li><a href="#">{label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.nav {
		border-bottom: 1px solid var(--color-border);
		position: sticky;
		top: 0;
		background: rgba(11, 11, 12, 0.85);
		backdrop-filter: blur(8px);
		z-index: 10;
	}

	.nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 72px;
	}

	.nav__logo {
		font-weight: 800;
		letter-spacing: 0.04em;
		color: var(--color-text);
		text-decoration: none;
		font-size: 18px;
	}

	.nav__links {
		display: flex;
		gap: 32px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav__links a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 14px;
		font-weight: 500;
	}

	.nav__links a:hover {
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.nav__links {
			display: none;
		}
	}
</style>
